NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Comma-separated UW Google account domains allowed to sign in.
UW_AUTH_DOMAINS=uw.edu,u.washington.edu

# Optional comma-separated list. If set, only these UW emails can choose professor access.
PROFESSOR_EMAIL_ALLOWLIST=

# Student voice-note transcription and usage telemetry.
ELEVENLABS_API_KEY=

# Ora AI interview and report generation.
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash-lite
